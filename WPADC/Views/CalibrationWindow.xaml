<Window x:Class="WPADC.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="九点标定"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F6FA"
        Foreground="#FF1A237E">
    <Window.Resources>
        <Style TargetType="Button" x:Key="DarkButton">
            <Setter Property="Background" Value="#FF1A237E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF283593"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF0D1452"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="CalibTextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="BorderBrush" Value="#FFB0B8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="BorderBrush" Value="#FFD0D8E8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="像素坐标 (row, col)" Margin="0,0,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="PixelRow1" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="0" Grid.Column="2" x:Name="PixelCol1" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="PixelRow2" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="PixelCol2" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="3" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PixelRow3" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="2" Grid.Column="2" x:Name="PixelCol3" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="4" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="PixelRow4" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="3" Grid.Column="2" x:Name="PixelCol4" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="5" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="PixelRow5" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="4" Grid.Column="2" x:Name="PixelCol5" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="6" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="PixelRow6" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="5" Grid.Column="2" x:Name="PixelCol6" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="7" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="PixelRow7" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="6" Grid.Column="2" x:Name="PixelCol7" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="8" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="PixelRow8" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="7" Grid.Column="2" x:Name="PixelCol8" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="9" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="PixelRow9" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="8" Grid.Column="2" x:Name="PixelCol9" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="物理坐标 (X, Y)" Margin="5,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="WorldX1" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="0" Grid.Column="2" x:Name="WorldY1" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="WorldX2" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="WorldY2" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="3" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="WorldX3" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="2" Grid.Column="2" x:Name="WorldY3" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="4" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="WorldX4" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="3" Grid.Column="2" x:Name="WorldY4" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="5" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="WorldX5" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="4" Grid.Column="2" x:Name="WorldY5" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="6" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="WorldX6" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="5" Grid.Column="2" x:Name="WorldY6" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="7" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="WorldX7" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="6" Grid.Column="2" x:Name="WorldY7" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="8" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="WorldX8" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="7" Grid.Column="2" x:Name="WorldY8" Style="{StaticResource CalibTextBox}" Margin="2,3"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="9" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5A6A8A" FontSize="12"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="WorldX9" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                    <TextBox Grid.Row="8" Grid.Column="2" x:Name="WorldY9" Style="{StaticResource CalibTextBox}" Margin="2,3"/>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button Content="生成变换矩阵" Style="{StaticResource DarkButton}" Click="GenerateMatrix_Click" Margin="8,0"/>
            <Button Content="保存标定数据" Style="{StaticResource DarkButton}" Click="SaveData_Click" Margin="8,0"/>
            <Button Content="调用标定数据" Style="{StaticResource DarkButton}" Click="LoadData_Click" Margin="8,0"/>
            <Button Content="确认" Style="{StaticResource DarkButton}" Click="Save_Click" Margin="8,0"/>
            <Button Content="取消" Style="{StaticResource DarkButton}" Click="Cancel_Click" Margin="8,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFD0D8E8" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
            <TextBlock x:Name="HomMatText" Foreground="#FF1A237E" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
