<Window x:Class="WPADC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
        Title="点胶机定位纠偏系统"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F6FA"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button" x:Key="DarkButton">
            <Setter Property="Background" Value="#FF1A237E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF283593"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF0D1452"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}"/>
        <Style TargetType="Button" x:Key="GreenButton" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#FF2E7D32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF43A047"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="RedButton" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#FFC62828"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFB71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton" x:Key="GlueToggleStyle">
            <Setter Property="Background" Value="#FF1A237E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="ParamTextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="BorderBrush" Value="#FFB0B8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MaxWidth" Value="90"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="BorderBrush" Value="#FFB0B8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="BorderBrush" Value="#FFB0B8D0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="Label" x:Key="ParamLabel">
            <Setter Property="Foreground" Value="#FF5A6A8A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label" x:Key="ShortParamLabel">
            <Setter Property="Foreground" Value="#FF5A6A8A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="55"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF5A6A8A"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="BorderBrush" Value="#FFD0D8E8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FFF5F6FA"/>
            <Setter Property="BorderBrush" Value="#FFD0D8E8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#FFE0E4EE"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="BorderBrush" Value="#FFD0D8E8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="6">
        <!-- 顶部时间栏 -->
        <Border DockPanel.Dock="Top" Background="#FF1A237E" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
            <Grid>
                <TextBlock Text="定位纠偏点胶机（运控仿真）" Foreground="White" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding CurrentTime}" Foreground="#FFB0C4FF" FontWeight="Medium" FontSize="19" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ========== Left column: Camera controls + Camera params ========== -->
            <Grid Grid.Column="0" Margin="0,0,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="相机控制" Margin="0,0,0,3">
                    <StackPanel>
                        <Button Content="连接相机" Command="{Binding ConnectCameraCommand}" Margin="2" Style="{StaticResource GreenButton}"/>
                        <Button Content="断开相机" Command="{Binding DisconnectCameraCommand}" Margin="2" Style="{StaticResource RedButton}"/>
                        <Button Content="实时预览" Command="{Binding StartLiveDisplayCommand}" Margin="2"/>
                        <Button Content="停止预览" Command="{Binding StopLiveDisplayCommand}" Margin="2"/>
                        <Separator Margin="2,6" Background="#FFD0D8E8"/>
                        <Button Content="绘制Mark1" Command="{Binding DrawMark1Command}" Margin="2"/>
                        <Button Content="绘制Mark2" Command="{Binding DrawMark2Command}" Margin="2"/>
                        <Button Content="保存模板" Command="{Binding SaveTemplateCommand}" Margin="2"/>
                        <Button Content="加载模板" Command="{Binding LoadTemplateCommand}" Margin="2"/>
                        <Button Content="删除模板" Command="{Binding DeleteTemplateCommand}" Margin="2" Style="{StaticResource RedButton}"/>
                        <Separator Margin="2,6" Background="#FFD0D8E8"/>
                        <Button Content="开始检测" Command="{Binding StartDetectionCommand}" Margin="2" Style="{StaticResource GreenButton}"/>
                        <Button Content="关闭检测" Command="{Binding StopDetectionCommand}" Margin="2" Style="{StaticResource RedButton}"/>
                        <Separator Margin="2,6" Background="#FFD0D8E8"/>
                        <Button Content="九点标定" Command="{Binding OpenCalibrationCommand}" Margin="2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="相机参数" Margin="0,3,0,0" IsEnabled="{Binding IsDeviceReady}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Label Content="相机序列号:"/>
                            <TextBox Text="{Binding CameraSerialNumber, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                            <Label Content="曝光时间(μs):"/>
                            <TextBox Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                            <Label Content="增益:"/>
                            <TextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                            <CheckBox Content="自动曝光" IsChecked="{Binding AutoExposure}" Margin="4"/>
                            <CheckBox Content="自动增益" IsChecked="{Binding AutoGain}" Margin="4"/>
                            <Button Content="应用曝光/增益" Command="{Binding ApplyExposureGainCommand}" Margin="2,6,2,2"/>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <!-- ========== Middle column: Camera preview + Trajectory/Status/JOG/Params ========== -->
            <Grid Grid.Column="1" Margin="3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Camera preview + Device status (width matches right panel below) -->
                <GroupBox Grid.Row="0" Header="相机预览" Margin="0,0,0,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="HalconContainer" SizeChanged="HalconContainer_SizeChanged" Grid.Column="0">
                            <halcon:HWindowControlWPF x:Name="HalconWindow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <Canvas x:Name="AxisOverlay" IsHitTestVisible="False" ClipToBounds="False"/>
                        </Grid>
                        <Border Grid.Column="1" Background="#FFEEF0F6" CornerRadius="4" Margin="4,0,0,0" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 重启和调试按钮 -->
                                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="设备重启" Command="{Binding DeviceResetCommand}" Margin="2,0" Padding="8,6" FontSize="15" Background="#FFD32F2F"/>
                                    <Button Grid.Column="1" Content="调试模式" Command="{Binding DebugModeCommand}" Margin="2,0" Padding="8,6" FontSize="15" Background="#FF6A1B9A"/>
                                </Grid>
                                <!-- 设备状态占满两列 -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                    <TextBlock Text="设备状态" FontWeight="Bold" FontSize="17" Foreground="#FF1A237E" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                    <Border Background="{Binding DetectionStatusColor}" CornerRadius="3" Padding="6,3" Margin="0,2">
                                        <TextBlock Text="{Binding DetectionStatusText}" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Separator Margin="0,6" Background="#FFD0D8E8"/>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="相机: " FontSize="13" Foreground="#FF5A6A8A"/>
                                            <TextBlock Text="{Binding IsCameraConnected}" FontSize="13" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="运控卡: " FontSize="13" Foreground="#FF5A6A8A"/>
                                            <TextBlock Text="{Binding IsCardConnected}" FontSize="13" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <!-- 左列 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="模板状态" FontWeight="Bold" FontSize="14" Foreground="#FF1A237E" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Mark1TemplateStatus}" FontSize="14" Margin="4,0,0,1"/>
                                    <TextBlock Text="{Binding Mark2TemplateStatus}" FontSize="14" Margin="4,0,0,1"/>
                                    <Separator Margin="0,4" Background="#FFD0D8E8"/>
                                    <TextBlock Text="匹配结果" FontWeight="Bold" FontSize="14" Foreground="#FF1A237E" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Mark1MatchStatus}" FontSize="14" Margin="4,0,0,1"/>
                                    <TextBlock Text="{Binding Mark2MatchStatus}" FontSize="14" Margin="4,0,0,1"/>
                                    <Separator Margin="0,4" Background="#FFD0D8E8"/>
                                    <TextBlock Text="纠偏数据" FontWeight="Bold" FontSize="14" Foreground="#FF8A6A2A" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding DeltaXInfo}" FontSize="14" FontWeight="Medium" Margin="4,0,0,1"/>
                                    <TextBlock Text="{Binding DeltaYInfo}" FontSize="14" FontWeight="Medium" Margin="4,0,0,1"/>
                                    <TextBlock Text="{Binding DeltaAngleInfo}" FontSize="14" FontWeight="Medium" Margin="4,0,0,1"/>
                                </StackPanel>
                                <!-- 右列 -->
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="像素坐标" FontWeight="Bold" FontSize="14" Foreground="#FF1A237E" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Mark1PixelInfo}" FontSize="14" Margin="4,0,0,1"/>
                                    <TextBlock Text="{Binding Mark2PixelInfo}" FontSize="14" Margin="4,0,0,1"/>
                                    <Separator Margin="0,4" Background="#FFD0D8E8"/>
                                    <TextBlock Text="物理坐标" FontWeight="Bold" FontSize="14" Foreground="#FF1565C0" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Mark1PhysInfo}" FontSize="14" FontWeight="Medium" Margin="4,0,0,1"/>
                                    <TextBlock Text="{Binding Mark2PhysInfo}" FontSize="14" FontWeight="Medium" Margin="4,0,0,1"/>
                                    <Separator Margin="0,4" Background="#FFD0D8E8"/>
                                    <TextBlock Text="其他信息" FontWeight="Bold" FontSize="14" Foreground="#FF1A237E" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding CalibrationStatus}" FontSize="14" Margin="4,0,0,1"/>
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,1">
                                        <TextBlock Text="胶阀气压: " FontSize="14" Foreground="#FF5A6A8A"/>
                                        <TextBlock Text="{Binding GluePressureInfo}" FontSize="14" FontWeight="Medium" Foreground="#FFC62828"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,1">
                                        <TextBlock Text="调试模式: " FontSize="14" Foreground="#FF5A6A8A"/>
                                        <TextBlock Text="{Binding IsDebugMode}" FontSize="14" FontWeight="Medium"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- Row 1: Trajectory (left) + Status/JOG/Motion params (right, same width as device status) -->
                <Grid Grid.Row="1" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Trajectory simulation -->
                    <GroupBox Grid.Column="0" Header="运动轨迹仿真 (俯视XY)" Margin="0,0,2,0">
                        <Grid>
                            <Canvas x:Name="TrajectoryCanvas" Background="White" ClipToBounds="True"/>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                                <Button Content="清除轨迹" Command="{Binding ClearTrailCommand}" FontSize="14" Padding="10,4"/>
                            </StackPanel>
                            <Border x:Name="DataPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#CCFFFFFF" BorderBrush="#FFB0B8D0" BorderThickness="1" CornerRadius="4" Padding="6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="数据盘" FontWeight="Bold" FontSize="15" Foreground="#FF1A237E" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="DataPanelX" Text="X: 0.00 mm" FontSize="15" Foreground="#FF1A237E"/>
                                    <TextBlock x:Name="DataPanelY" Text="Y: 0.00 mm" FontSize="15" Foreground="#FF1A237E"/>
                                    <TextBlock x:Name="DataPanelM1" Text="M1: --" FontSize="14" Foreground="#FF2E7D32"/>
                                    <TextBlock x:Name="DataPanelM2" Text="M2: --" FontSize="14" Foreground="#FF9C27B0"/>
                                    <TextBlock x:Name="DataPanelDX" Text="ΔX: 0.000 mm" FontSize="15" Foreground="#FF8A6A2A"/>
                                    <TextBlock x:Name="DataPanelDY" Text="ΔY: 0.000 mm" FontSize="15" Foreground="#FF8A6A2A"/>
                                    <TextBlock x:Name="DataPanelGlue" Text="出胶: 关" FontSize="15" Foreground="#FFC62828"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Right: Status + JOG + Motion params (宽度与设备状态对齐) -->
                    <ScrollViewer Grid.Column="1" Margin="2,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Motion status -->
                            <GroupBox Header="运动状态" Margin="0,0,0,2" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="1">
                                        <Label Content="X(mm):"/>
                                        <TextBlock Text="{Binding AxisXPos, StringFormat=F2}" Foreground="#FF1565C0" VerticalAlignment="Center" FontWeight="Bold" Width="65"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="1">
                                        <Label Content="Y(mm):"/>
                                        <TextBlock Text="{Binding AxisYPos, StringFormat=F2}" Foreground="#FF1565C0" VerticalAlignment="Center" FontWeight="Bold" Width="65"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="1">
                                        <Label Content="ΔX:"/>
                                        <TextBlock Text="{Binding DeltaX, StringFormat=F3}" Foreground="#FF8A6A2A" VerticalAlignment="Center" Width="65"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="1">
                                        <Label Content="ΔY:"/>
                                        <TextBlock Text="{Binding DeltaY, StringFormat=F3}" Foreground="#FF8A6A2A" VerticalAlignment="Center" Width="65"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="1">
                                        <Label Content="控制卡:"/>
                                        <TextBlock Text="{Binding IsCardConnected}" Foreground="#FFC62828" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="1">
                                        <Label Content="录制:"/>
                                        <TextBlock Text="{Binding IsRecordingRecipe}" Foreground="#FF4CAF50" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- JOG -->
                            <GroupBox Header="Jog" Margin="0,2" Padding="3" IsEnabled="{Binding IsDeviceReady}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="1" Content="Y+" Margin="1" Padding="6,4" FontSize="15" PreviewMouseDown="JogYPos_PreviewMouseDown" PreviewMouseUp="Jog_PreviewMouseUp"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="X-" Margin="1" Padding="6,4" FontSize="15" PreviewMouseDown="JogXNeg_PreviewMouseDown" PreviewMouseUp="Jog_PreviewMouseUp"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="⌂" Margin="1" Padding="6,4" FontSize="15" PreviewMouseDown="JogHome_PreviewMouseDown"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="X+" Margin="1" Padding="6,4" FontSize="15" PreviewMouseDown="JogXPos_PreviewMouseDown" PreviewMouseUp="Jog_PreviewMouseUp"/>
                                    <Button Grid.Row="2" Grid.Column="1" Content="Y-" Margin="1" Padding="6,4" FontSize="15" PreviewMouseDown="JogYNeg_PreviewMouseDown" PreviewMouseUp="Jog_PreviewMouseUp"/>
                                </Grid>
                            </GroupBox>

                            <!-- Motion params: 回原速度/JOG速度加减速 4行对齐 + 出胶按钮 -->
                            <GroupBox Header="运动参数" Margin="0,2" Padding="4" IsEnabled="{Binding IsDeviceReady}">
                                <StackPanel>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="回原速度(mm/s):" Style="{StaticResource ParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding HomeVelocity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="JOG速度(mm/s):" Style="{StaticResource ParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding JogVelocity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="JOG加速(mm/s²):" Style="{StaticResource ParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding JogAcceleration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="JOG减速(mm/s²):" Style="{StaticResource ParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding JogDeceleration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>

                                    <ToggleButton x:Name="GlueToggleButton"
                                              Content="{Binding GlueButtonText}"
                                              IsChecked="{Binding GlueOutputOn}"
                                              Style="{StaticResource GlueToggleStyle}"
                                              MinHeight="48" FontSize="19" FontWeight="Bold" Padding="20,10" Margin="4"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========== Right column: Control buttons + Interpolation + Recipe + Log ========== -->
            <Grid Grid.Column="2" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="475"/>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Control buttons (连接/断开/回原/急停) -->
                <GroupBox Grid.Row="0" Header="运动控制" Margin="0,0,0,3" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="连接控制卡" Command="{Binding ConnectCardCommand}" Margin="2" Style="{StaticResource GreenButton}"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="断开" Command="{Binding DisconnectCardCommand}" Margin="2" Style="{StaticResource RedButton}"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="回原点" Command="{Binding HomeCommand}" Margin="2"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="{Binding EstopButtonText}" Command="{Binding EmergencyStopCommand}" Margin="2" Background="#FFC62828" FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FontSize" Value="17"/>
                                    <Setter Property="Padding" Value="18,10"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEstopActive}" Value="False">
                                            <Setter Property="FontSize" Value="19"/>
                                            <Setter Property="Padding" Value="24,14"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </GroupBox>

                <!-- Row 1: Interpolation (直线+圆弧) -->
                <GroupBox Grid.Row="1" Header="插补运动" Margin="0,0,0,3" Padding="4" IsEnabled="{Binding IsDeviceReady}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="直线插补 (mm, mm/s)" Margin="0,0,0,4" Padding="4">
                                <StackPanel>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="X:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding LinearTargetX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                        <Label Grid.Column="2" Content="Y:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="3" Text="{Binding LinearTargetY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="速度:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding LinearVelocity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                        <Label Grid.Column="2" Content="加速:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="3" Text="{Binding LinearAcceleration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="减速:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding LinearDeceleration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Button Content="执行直线插补" Command="{Binding LinearInterpCommand}" Margin="2" Background="#FF0D47A1"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="圆弧插补 (mm, mm/s)" Margin="0,0,0,4" Padding="4">
                                <StackPanel>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="终点X:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding ArcEndPointX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                        <Label Grid.Column="2" Content="终点Y:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="3" Text="{Binding ArcEndPointY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="半径R:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding ArcRadiusR, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                        <CheckBox Grid.Column="2" Content="顺时针CW" IsChecked="{Binding ArcClockwise}" Margin="2" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="速度:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding ArcVelocity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                        <Label Grid.Column="2" Content="加速:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="3" Text="{Binding ArcAcceleration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="减速:" Style="{StaticResource ShortParamLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding ArcDeceleration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" Margin="2"/>
                                    </Grid>
                                    <Label Content="R正=劣弧＜180°  R负=优弧＞180°" FontSize="12" Foreground="Gray" Margin="2,0"/>
                                    <Button Content="执行圆弧插补" Command="{Binding ArcInterpCommand}" Margin="2" Background="#FF6A1B9A"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- Row 2: Recipe management -->
                <GroupBox Grid.Row="2" Header="配方管理" Margin="0,0,0,3" Padding="4" IsEnabled="{Binding IsDeviceReady}">
                    <StackPanel>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Content="新建配方" Command="{Binding NewRecipeCommand}" Margin="1" Background="#FF0D47A1"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="取消配方" Command="{Binding CancelRecipeCommand}" Margin="1" Style="{StaticResource RedButton}"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="保存配方" Command="{Binding SaveRecipeCommand}" Margin="1" Background="#FF0D47A1"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="确认起点" Command="{Binding ConfirmStartPointCommand}" Margin="1" Background="#FF0D47A1"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="确认终点" Command="{Binding ConfirmEndPointCommand}" Margin="1" Background="#FF0D47A1"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="调用配方" Command="{Binding LoadRecipeCommand}" Margin="1" Background="#FF0D47A1"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="删除配方" Command="{Binding DeleteRecipeCommand}" Margin="1" Style="{StaticResource RedButton}"/>
                        </Grid>
                        <ListBox x:Name="RecipeListBox" Height="50"
                             ItemsSource="{Binding Recipes}" DisplayMemberPath="Name"
                             SelectedIndex="{Binding SelectedRecipeIndex}"
                             SelectionChanged="RecipeListBox_SelectionChanged" Margin="2"/>
                        <ListBox Height="55" ItemsSource="{Binding CurrentRecipePoints}" Margin="2">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}: ({1:F1},{2:F1}) V={3:F0} Glue={4}">
                                                <Binding Path="Type"/>
                                                <Binding Path="X"/>
                                                <Binding Path="Y"/>
                                                <Binding Path="Speed"/>
                                                <Binding Path="GlueOn"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </GroupBox>

                <!-- Row 3: Log -->
                <GroupBox Grid.Row="3" Header="操作日志" Margin="0,2,0,0" Padding="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="47*"/>
                            <ColumnDefinition Width="294*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox Grid.Row="0" ItemsSource="{Binding Logs}" Margin="1,1,1,1" Grid.ColumnSpan="2">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" FontSize="12">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="[{0:HH:mm:ss.fff}][{1}] {2}">
                                                <Binding Path="Timestamp"/>
                                                <Binding Path="Level"/>
                                                <Binding Path="Message"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF1A237E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#FFC62828"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="Foreground" Value="#FFFF8F00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="1" Content="导出日志" Command="{Binding ExportLogsCommand}" Margin="2,2,0,2" HorizontalAlignment="Left" FontSize="14" Padding="10,4" Grid.ColumnSpan="2"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
